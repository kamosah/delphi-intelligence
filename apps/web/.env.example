# Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Configuration (for Supabase SSR authentication)
# Get these from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Note: Authentication is handled by Supabase SSR with HTTP-only cookies
# No additional auth secrets needed for the frontend

# External APIs (add as needed)
# STRIPE_SECRET_KEY=
# SENDGRID_API_KEY=