# Supabase Test Project Configuration
# This file contains environment variables for E2E testing with Playwright
# IMPORTANT: Create .env.test with actual credentials (DO NOT commit to git)

# Supabase Test Project
# Get these from Supabase Dashboard > Settings > API > "Project API keys (JWT)" tab
NEXT_PUBLIC_SUPABASE_URL=https://your-test-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_test_anon_jwt_key_here
NEXT_PUBLIC_SUPABASE_PROJECT_ID=your_test_project_id
SUPABASE_SERVICE_ROLE_KEY=your_test_service_role_jwt_key_here
DB_PASSWORD=your_test_db_password

# Backend Test API (runs on port 8001 to avoid conflict with production)
NEXT_PUBLIC_API_URL=http://localhost:8001

# Test-specific flags
CI=false
NODE_ENV=test
