/**
 * Olympus Authorization Schema
 *
 * Models:
 * - RBAC: Organization roles (owner, admin, member, viewer)
 * - ReBAC: Space membership and relationships
 * - ABAC: Subscription tiers, time-based access via caveats
 */

use expiration

// ============================================================================
// User Definition
// ============================================================================

definition user {}

// ============================================================================
// Organization - RBAC Pattern
// ============================================================================

definition organization {
  // Relationships
  relation owner: user
  relation admin: user
  relation member: user | user with expiration
  relation viewer: user

  // Permissions (hierarchical)
  permission delete = owner
  permission manage_settings = owner + admin
  permission manage_billing = owner
  permission invite_member = owner + admin
  permission remove_member = owner + admin
  permission view = viewer + member + admin + owner
}

// ============================================================================
// Space - ReBAC Pattern with Organization Inheritance
// ============================================================================

definition space {
  // Relationships
  relation organization: organization
  relation owner: user
  relation editor: user
  relation viewer: user

  // Permissions
  permission delete = owner + organization->admin
  permission manage_members = owner + organization->admin
  permission upload_document = owner + editor + organization->admin
  permission update = owner + editor + organization->admin
  permission read = viewer + editor + owner
}

// ============================================================================
// Document - Space-Based Permissions
// ============================================================================

definition document {
  // Relationships
  relation space: space
  relation uploader: user

  // Permissions (inherit from space)
  permission delete = uploader + space->manage_members
  permission update = uploader + space->upload_document
  permission read = space->read
}

// ============================================================================
// Thread - Owner-Based Permissions with Visibility Scoping
// ============================================================================

definition thread {
  // Relationships
  relation owner: user                   // Primary ownership: user who owns the thread (LOG-255)
  relation organization: organization    // Optional: organization context (nullable for personal threads)
  relation space: space                  // Optional: space context (nullable for personal/org threads)

  // Permissions
  permission delete = owner + space->manage_members + organization->admin
  permission update = owner + space->owner + organization->admin

  // ============================================================================
  // Dual Read Permissions: Visibility-Based Access Control
  // ============================================================================
  //
  // Threads use TWO read permissions to prevent permission leaks:
  //
  // 1. 'read' permission (space-scoped & personal threads):
  //    - For threads WITH space_id: accessible to space members (space->read)
  //    - For threads WITHOUT space_id AND org_id: personal threads (owner only)
  //    - Does NOT grant access via organization membership (prevents leaks)
  //
  // 2. 'read_org' permission (organization-wide threads):
  //    - For threads WITHOUT space_id BUT WITH org_id: org-wide visibility
  //    - Accessible to all organization members (organization->view)
  //    - Used for company-wide announcements, shared resources
  //
  // Application logic: Use check_thread_read_permission() helper
  // - If thread.space_id != None → use 'read' permission
  // - If thread.space_id == None → use 'read_org' permission
  //
  // Why split permissions?
  // - Prevents org members from bypassing space restrictions
  // - Space threads remain isolated within team workspaces
  // - Org threads are explicitly shared company-wide
  //
  // Read permission for space/personal threads (does NOT include org->view to prevent leaks)
  // IMPORTANT: Does NOT include organization->admin intentionally
  // - Space threads should remain isolated to team workspaces
  // - Prevents admin overreach and maintains privacy expectations
  // - If admin needs access, add them as space member explicitly
  // - Matches org models where departments (HR, finance) have restricted access
  permission read = owner + space->read

  // Read permission for org-wide threads (requires organization membership)
  // Note: organization->admin is included via organization->view (admins are also viewers)
  permission read_org = owner + organization->view
}

// ============================================================================
// Message - Thread Message Authorship
// ============================================================================

definition message {
  // Relationships
  relation thread: thread                // Parent thread
  relation author: user                  // Message author (nullable in DB, grants editing rights)

  // Permissions (inherit from thread)
  permission read = thread->read + thread->read_org
  permission update = author
  permission delete = thread->owner + author
}

// ============================================================================
// Organization Invitation - Pre-Authorization
// ============================================================================

definition organization_invitation {
  // Relationships
  relation organization: organization
  relation inviter: user
  relation invitee: user

  // Permissions
  permission revoke = organization->admin
  permission resend = organization->admin
  permission accept = invitee
  permission view = invitee + organization->admin
}

// ============================================================================
// Caveats - ABAC for Subscription Tiers
// ============================================================================

caveat has_pro_subscription(user_tier string) {
  user_tier == "pro" || user_tier == "enterprise"
}

caveat has_enterprise_subscription(user_tier string) {
  user_tier == "enterprise"
}

/**
 * Caveat: within_trial_period
 *
 * Checks if the current time is before the trial end date.
 *
 * Usage Example (Python):
 *   from datetime import datetime, timedelta
 *   from app.schemas.spicedb import WriteRelationshipInput, CheckPermissionInput
 *
 *   # Step 1: Write relationship (NO context at write time)
 *   trial_end = int((datetime.now() + timedelta(days=30)).timestamp())
 *   await spicedb.write_relationship(
 *       WriteRelationshipInput(
 *           resource_type="advanced_feature",
 *           resource_id="feature-id",
 *           relation="user",
 *           subject_type="user",
 *           subject_id=user_id
 *       )
 *   )
 *
 *   # Step 2: Check permission WITH context (context evaluated at check time)
 *   has_access = await spicedb.check_permission(
 *       CheckPermissionInput(
 *           user_id=user_id,
 *           permission="access",
 *           resource_type="advanced_feature",
 *           resource_id="feature-id",
 *           context={
 *               "current_time": int(datetime.now().timestamp()),
 *               "trial_end": trial_end
 *           }
 *       )
 *   )
 *
 * IMPORTANT: Context values are provided at permission check time, NOT at relationship write time.
 * The caveat is evaluated when checking permissions using the context provided in CheckPermissionInput.
 */
caveat within_trial_period(current_time timestamp, trial_end timestamp) {
  current_time < trial_end
}

// ============================================================================
// Advanced Features (Gated by Subscription)
// ============================================================================

definition advanced_feature {
  relation user: user with has_pro_subscription | user with within_trial_period
  permission access = user
}

definition enterprise_feature {
  relation user: user with has_enterprise_subscription
  permission access = user
}
