# Olympus API Production Environment Configuration
# Copy this file to .env in production and fill in the values

# ============================================================================
# CORE APPLICATION SETTINGS
# ============================================================================

# Environment (development, staging, production)
ENV=production

# Debug mode - MUST be false in production (disables /docs, /redoc endpoints)
DEBUG=false

# Server configuration
HOST=0.0.0.0
PORT=8000
APP_NAME="Olympus MVP API"

# ============================================================================
# DATABASE CONFIGURATION (Supabase PostgreSQL)
# ============================================================================

# Supabase Database URL (use session pooler for production)
# Format: postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# IMPORTANT: Use the "Session" pooler endpoint, not direct connection
DATABASE_URL=postgresql+asyncpg://postgres.xxxxx:your-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================

# Supabase Project URL
# Format: https://[PROJECT-REF].supabase.co
SUPABASE_URL=https://xxxxx.supabase.co

# Supabase Anonymous Key (public, safe to expose in frontend)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# Supabase Service Role Key (SENSITIVE - never expose to frontend)
# Used for admin operations like user management
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

# Redis URL for session management and caching
# Render auto-populates this when using their Redis add-on
# Format: redis://red-xxxxx:6379
REDIS_URL=redis://localhost:6379

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# CORS Origin Regex (set to empty to disable regex matching in production)
CORS_ORIGIN_REGEX=

# Allowed CORS origins (JSON array format)
# Add your frontend URLs here (exact matches only)
# Example: ["https://olympus.vercel.app", "https://app.olympus.com"]
CORS_ORIGINS=["https://olympus-demo.vercel.app"]

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================

# JWT secret key - GENERATE A STRONG RANDOM SECRET
# Use: openssl rand -hex 32
JWT_SECRET=your-random-32-character-secret-here

# JWT algorithm (HS256 recommended)
JWT_ALGORITHM=HS256

# JWT token expiration (hours)
JWT_EXPIRATION_HOURS=24

# ============================================================================
# OPENAI CONFIGURATION (Required for AI features)
# ============================================================================

# OpenAI API Key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxx

# Embedding model for document vectorization
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Batch size for embedding generation (max 100)
OPENAI_EMBEDDING_BATCH_SIZE=100

# Max retries for OpenAI API calls
OPENAI_MAX_RETRIES=3

# Chat model for AI agent
OPENAI_CHAT_MODEL=gpt-4-turbo-preview

# Temperature for LLM responses (0.0 = deterministic, 1.0 = creative)
OPENAI_TEMPERATURE=0.0

# Max tokens in LLM response
OPENAI_MAX_TOKENS=2000

# ============================================================================
# LANGSMITH CONFIGURATION (Optional - for observability)
# ============================================================================

# Enable LangSmith tracing (true/false)
LANGCHAIN_TRACING_V2=false

# LangSmith API key (only if LANGCHAIN_TRACING_V2=true)
# Get from: https://smith.langchain.com/
LANGCHAIN_API_KEY=

# LangSmith project name
LANGCHAIN_PROJECT=olympus-production

# ============================================================================
# DEPLOYMENT NOTES
# ============================================================================

# Render Deployment:
# 1. Set all required environment variables in Render dashboard
# 2. REDIS_URL is auto-populated by Render Redis add-on
# 3. DATABASE_URL must use Supabase session pooler endpoint
# 4. Ensure DEBUG=false to disable documentation endpoints
# 5. Generate strong JWT_SECRET: openssl rand -hex 32
# 6. Add production frontend URL to CORS_ORIGINS

# Cost Estimate (as of 2024):
# - Render Web Service (Free tier): $0/month (sleeps after 15 min inactivity)
# - Render Redis (Free tier): $0/month (25MB)
# - Supabase (Free tier): $0/month (500MB database, 50MB file storage)
# - OpenAI: ~$0.02 per 1M tokens (embedding), $0.01-$0.03 per 1K tokens (GPT-4)

# Security Checklist:
# ✓ DEBUG=false in production
# ✓ Strong random JWT_SECRET (32+ characters)
# ✓ SUPABASE_SERVICE_ROLE_KEY never exposed to frontend
# ✓ DATABASE_URL uses session pooler (not direct connection)
# ✓ CORS_ORIGINS restricted to your frontend domains only
# ✓ Environment variables stored securely (Render secrets, not in git)
