# FastAPI Configuration (Test Environment)
ENV=test
DEBUG=true
HOST=0.0.0.0
PORT=8000
APP_NAME=Olympus API (Test)

# Supabase Configuration - Using LOCAL Supabase for integration tests
# These are default keys from `npx supabase start` (safe to commit)
# Get connection details with: npx supabase status
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Cloud Supabase Test Project (alternative - not used for local integration tests)
# Get from: Supabase Dashboard > Settings > API
# SUPABASE_URL=https://your-test-project.supabase.co
# SUPABASE_ANON_KEY=your_test_anon_jwt_key_here
# SUPABASE_SERVICE_ROLE_KEY=your_test_service_role_jwt_key_here

# Database Configuration - Using LOCAL PostgreSQL from Supabase
# Connection to local PostgreSQL (port 54322)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
DB_PASSWORD=postgres

# Cloud Supabase Database (alternative - not used for local integration tests)
# Get from: Supabase Dashboard > Settings > Database > Connection string
# DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-X-region.pooler.supabase.com:5432/postgres
# DB_PASSWORD=your_test_db_password

# Redis Configuration (Docker)
REDIS_URL=redis://redis:6379/0

# CORS Configuration (Allow test frontend)
CORS_ORIGINS=["http://localhost:3000"]

# JWT Authentication Configuration
JWT_SECRET=CHANGE_THIS_TO_SECURE_RANDOM_STRING_MIN_32_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# OpenAI Configuration (for embeddings and AI features)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_BATCH_SIZE=100
OPENAI_MAX_RETRIES=3

# LangChain LLM Configuration (for AI agent)
OPENAI_CHAT_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.0
OPENAI_MAX_TOKENS=2000

# LangSmith Configuration (optional observability)
# Disabled for test environment
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=olympus
