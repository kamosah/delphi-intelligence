# FastAPI Configuration
ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
APP_NAME=Olympus API

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database Configuration (Supabase only)
# Get your connection string from: Supabase Dashboard > Settings > Database > Connection String > Session Pooler
# Format: postgresql+asyncpg://postgres.[project-ref]:[password]@aws-X-region.pooler.supabase.com:5432/postgres
# Note: Use session pooler (port 5432) for both migrations and runtime (direct connection DNS not resolvable in Docker)
DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-X-region.pooler.supabase.com:5432/postgres

# Redis Configuration (for session management)
# When using Docker Compose: redis://redis:6379/0
# When running locally: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# SpiceDB Configuration (for authorization)
# CRITICAL: Generate a secure random token before use!
# Run this command: openssl rand -base64 32
# Both SPICEDB_TOKEN and SPICEDB_GRPC_PRESHARED_KEY must have the same value
SPICEDB_TOKEN=your-development-token-here-change-in-production
SPICEDB_GRPC_PRESHARED_KEY=your-development-token-here-change-in-production
# When using Docker Compose: spicedb:50051
# When running locally: localhost:50051
SPICEDB_ENDPOINT=spicedb:50051
# Uses same Supabase database connection for SpiceDB datastore
# IMPORTANT: Use DIRECT database connection (not pooler) for SpiceDB migrations
# Poolers like .pooler.supabase.com don't support all PostgreSQL features needed for migrations
# Get direct connection from: Supabase Dashboard > Settings > Database > Connection String > Direct Connection
# Format: postgresql://postgres.[project-ref]:[password]@aws-X-region.supabase.com:6543/postgres
# Note: Direct connection uses port 6543, session pooler uses port 5432
SPICEDB_DATASTORE_CONN_URI=postgresql://postgres.[project-ref]:[password]@aws-X-region.supabase.com:6543/postgres

# CORS Configuration
# For development: Uses regex to match localhost:3000-3005
CORS_ORIGIN_REGEX=^https?://localhost:300[0-5]$
CORS_ORIGINS=[]

# JWT Authentication Configuration
JWT_SECRET=your-super-secure-jwt-secret-key-here-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# External APIs (add as needed)
# STRIPE_SECRET_KEY=
# SENDGRID_API_KEY=

# OpenAI Configuration (for embeddings and AI features)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_BATCH_SIZE=100
OPENAI_MAX_RETRIES=3

# LangChain LLM Configuration (for AI agent)
OPENAI_CHAT_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.0
OPENAI_MAX_TOKENS=2000

# LangSmith Configuration (optional observability)
# Sign up at https://smith.langchain.com/
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=olympus